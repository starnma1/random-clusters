get_starting_sequence = function(pi, N) {
# Sample a starting sequence of length N
# Define the starting sequence
starting_sequence <- c()
# Sample a nucleotide and add it onto the starting sequence
for (i in 1:N){
sampled_nuc <- get_starting_nucleotide(pi)
starting_sequence <- append(starting_sequence, sampled_nuc)
}
# Return the sampled sequence
# starting_sequence: vector of integer nucleotide values
return(starting_sequence)
}
