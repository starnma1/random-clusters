beta = 0.035
alpha1 = 0.044229
alpha2 = 0.021781
pi = c(0.22, 0.26, 0.33, 0.19)
t = 100 # Starting value for probability transition matrix
# First create the Q matrix
Q <- create_TN93_Q_matrix(pi, alpha1, alpha2, beta)
# Define the Probability transition matrices
Pt <-  expm(Q*t)
P2t <- expm(Q * 2 * t)
# Define the while loop to get the time
while(is_matrix_unchanged(Pt, P2t, decimal = 7) == FALSE){
t = t + 100
Pt <-  expm(Q*t)
P2t <- expm(Q * 2 * t)
}
print(t)
