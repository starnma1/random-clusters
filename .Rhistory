create_TN93_Q_matrix = function(pi, alpha1, alpha2, beta) {
# Create the TN93 transition rate matrix Q as specified in the assignment.
Q <- matrix(NA, nrow = 4, ncol = 4)
# Fill in rows
Q[1,] = c(0, alpha1 * pi[2], beta * pi[3], beta * pi[4])
Q[2,] = c(alpha1 * pi[1], 0, beta * pi[3], beta * pi[4])
Q[3,] = c(beta * pi[1], beta * pi[2], 0, alpha2 * pi[4])
Q[4,] = c(beta * pi[1], beta * pi[2], alpha2 * pi[3], 0)
# Return the transition rate matrix
# Q: 4 by 4 matrix of rates (double)
return(Q)
}
