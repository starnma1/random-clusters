)
# Calculate the Predictions of eachs
pred_classical <- prediction(df_rocr$classical_t, labels = df_rocr$status,
label.ordering = c("non-differential", "differential"))
pred_moderated <- prediction(df_rocr$moderated_t, labels = df_rocr$status,
label.ordering = c("non-differential", "differential"))
pred_mean_diff <- prediction(df_rocr$mean_diff, labels = df_rocr$status,
label.ordering = c("non-differential", "differential"))
# Create the Performance metrics
