#' Compares elements of two matrices to see if they are identical
#'
#' @param old Old matrix
#' @param new New matrix
#' @param decimal Up to which decimal should the matrix entries remain unchanged?
#'
#' @return True if the two matrices are identical up to the specified decimal
is_matrix_unchanged <- function(old_matrix, new_matrix, decimal = 7) {
return(all(floor(old_matrix * 10^decimal) == floor(new_matrix * 10^decimal)))
}
create_TN93_Q_matrix = function(pi, alpha1, alpha2, beta) {
# Create the TN93 transition rate matrix Q as specified in the assignment.
Q <- matrix(NA, nrow = 4, ncol = 4)
# Fill in rows
Q[1,] = c(0, alpha1 * pi[2], beta * pi[3], beta * pi[4])
Q[2,] = c(alpha1 * pi[1], 0, beta * pi[3], beta * pi[4])
Q[3,] = c(beta * pi[1], beta * pi[2], 0, alpha2 * pi[4])
Q[4,] = c(beta * pi[1], beta * pi[2], alpha2 * pi[3], 0)
# Fill in Diagonals to equal to rowsum = 0
Q[1,1] = -sum(Q[1,])
Q[2,2] = -sum(Q[2,])
Q[3,3] = -sum(Q[3,])
Q[4,4] = -sum(Q[4,])
# Return the transition rate matrix
# Q: 4 by 4 matrix of rates (double)
return(Q)
}
